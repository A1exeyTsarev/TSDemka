<Window x:Class="BuildingMaterialsProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BuildingMaterialsProject"
        mc:Ignorable="d"
         Title="Чудо Обувь"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/Чудо Обувь.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource AccentBackground}"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/Images/Чудо Обувь.png"
                       Height="48" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="Чудо Обувь"
                           FontSize="22" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBlock x:Name="fio" Grid.Column="2"
                           VerticalAlignment="Center" FontSize="14"/>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Window>
