<Page x:Class="BuildingMaterialsProject.Pages.AddOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BuildingMaterialsProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{Binding OrderNumber, StringFormat=Заказ №{0}}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="tbHeader" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Клиент: " VerticalAlignment="Center"
                           Width="80"/>
                <ComboBox x:Name="cbClient" Width="300"
                          DisplayMemberPath="FIO"
                          SelectedValuePath="Id"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Дата: " VerticalAlignment="Center" Width="80"/>
                <DatePicker x:Name="dpDate" Width="200"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="dgItems" Grid.Row="1" Margin="0,15"
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар"
                    Binding="{Binding StockItems.Products.Name}" Width="*"/>
                <DataGridTextColumn Header="Производитель"
                    Binding="{Binding StockItems.Products.Manufacturers.ManufacturerName}"
                    Width="200"/>
                <DataGridTextColumn Header="Размер"
                    Binding="{Binding StockItems.Sizes.SizeValue}" Width="80"/>
                <DataGridTextColumn Header="Кол-во"
                    Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена"
                    Binding="{Binding PricePerUnit, StringFormat={}{0:N2} ₽}"
                    Width="120"/>
                <DataGridTextColumn Header="Сумма"
                    Binding="{Binding Sum, StringFormat={}{0:N2} ₽}"
                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="tbTotal" FontSize="18" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Добавить товар" Click="AddItem_Click"/>
            <Button Content="Удалить позицию" Background="#ff8080"
                    Click="RemoveItem_Click"/>
            <Button Content="Сохранить" Click="Save_Click"/>
            <Button Content="Назад" Click="Back_Click" Background="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Page>
