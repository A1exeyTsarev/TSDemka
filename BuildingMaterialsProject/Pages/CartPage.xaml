<Page x:Class="BuildingMaterialsProject.Pages.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BuildingMaterialsProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина — Чудо Обувь">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Корзина" FontSize="24"
                   FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView x:Name="listCart" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#70B2AF" BorderThickness="1"
                            CornerRadius="4" Margin="5" Padding="10"
                            Background="#D2F6E7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding ManufacturerName}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding ProductName}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Размер: "/>
                                    <Run Text="{Binding SizeValue}"/>
                                </TextBlock>
                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                       Text="{Binding PricePerUnit, StringFormat={}{0:N2} ₽}"/>

                            <TextBox Grid.Column="2" Text="{Binding Quantity}"
                                     VerticalContentAlignment="Center"
                                     LostFocus="Qty_LostFocus"/>

                            <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Text="{Binding Sum, StringFormat={}{0:N2} ₽}"/>

                            <Button Grid.Column="4" Content="Удалить"
                                    Background="#ff8080" Click="Remove_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock x:Name="tbTotal" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="0,0,20,0"/>
            <Button Content="Оформить заказ" Width="200"
                    Click="Checkout_Click"/>
            <Button Content="Очистить" Width="150" Background="#AAAAAA"
                    Click="Clear_Click"/>
            <Button Content="Назад" Width="150" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
