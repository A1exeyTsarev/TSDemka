<Page x:Class="BuildingMaterialsProject.Pages.ProductDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BuildingMaterialsProject.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{Binding Name}">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Width="280" Height="280"
               Stretch="Uniform" VerticalAlignment="Top"
               Source="{Binding ImagePath}"/>

        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock FontSize="16" Foreground="#555"
                       Text="{Binding Manufacturers.ManufacturerName}"/>

            <TextBlock FontSize="22" FontWeight="Bold" TextWrapping="Wrap"
                       Text="{Binding Name}"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="#70B2AF"
                           Text="{Binding FinalPrice, StringFormat={}{0:N2} ₽}"/>
                <TextBlock FontSize="16" Foreground="Red"
                           TextDecorations="Strikethrough" Margin="10,4,0,0"
                           Text="{Binding Price, StringFormat={}{0:N2} ₽}"/>
            </StackPanel>

            <TextBlock Margin="0,10,0,0">
                <Run Text="Категория: "/>
                <Run Text="{Binding Subcategories.Categories.CategoryName}"/>
                <Run Text=" / "/>
                <Run Text="{Binding Subcategories.SubcategoryName}"/>
            </TextBlock>

            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0">
                <Run Text="Состав: "/>
                <Run Text="{Binding Composition}"/>
            </TextBlock>

            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,10,0,0"
                       Text="{Binding Description}"/>

            <TextBlock Text="Размер:" Margin="0,15,0,5" FontWeight="Bold"/>
            <ComboBox x:Name="cbSize" Width="200"
                      ItemsSource="{Binding AvailableSizes}"
                      DisplayMemberPath="Sizes.SizeValue"
                      SelectedValuePath="Id"/>

            <TextBlock Text="Количество:" Margin="0,10,0,5" FontWeight="Bold"/>
            <TextBox x:Name="tbQty" Width="100" Text="1"/>

            <Button Content="Добавить в корзину" Width="200"
                    Margin="0,20,0,0" Click="Add_Click"/>
            <Button Content="Назад" Width="150" Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Page>
